# ==========================================
# SCA ENVIRONMENT CONFIGURATION - DEVELOPMENT
# ==========================================

# ENVIRONMENT
NODE_ENV=development

# FRONTEND API ENDPOINT
VITE_API_URL=http://localhost:5000

# BACKEND CONFIGURATION
# JWT Secret (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=sca-dev-secret-key-change-in-production

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:8080,http://127.0.0.1:3000

# DATABASE
DATABASE_URL=sqlite:///outputs/sca_events.db

# BLOCKCHAIN CONFIGURATION
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/
# BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
# CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Campus Department ID
TARGET_DEPT=CS_DEPARTMENT

# DATA MODE
# Set to 'mock' for sandbox data or 'production' for real data
DATA_MODE=mock
