# ==========================================
# SCA ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================
# Copy this file to .env and configure for your local setup

# ENVIRONMENT
NODE_ENV=development
DATA_MODE=mock
LOG_LEVEL=INFO

# FRONTEND CONFIGURATION
VITE_API_URL=http://localhost:5000

# AUTHENTICATION
JWT_SECRET_KEY=change-this-to-a-secure-random-key

# BACKEND SERVER
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
FORCE_HTTPS=false

# DATABASE
DATABASE_URL=sqlite:///outputs/sca_events.db

# BLOCKCHAIN
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com/
BLOCKCHAIN_PRIVATE_KEY=your_private_key_here
VITE_CONTRACT_ADDRESS=your_deployed_contract_address

# THIRDWEB
VITE_THIRDWEB_CLIENT_ID=your_client_id_here
VITE_THIRDWEB_SECRET_KEY=your_secret_key_here

# APP SETTINGS
TARGET_DEPT=CS_DEPARTMENT
