# ==========================================
# SCA ENVIRONMENT CONFIGURATION - PRODUCTION
# ==========================================

# ENVIRONMENT
NODE_ENV=production

# FRONTEND API ENDPOINT
# IMPORTANT: Change this to your production API URL
VITE_API_URL=https://api.sca.campus

# BACKEND CONFIGURATION
# JWT Secret - MUST BE CHANGED TO SECURE RANDOM KEY
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_KEY_IN_PRODUCTION

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# CORS Origins (comma-separated)
# IMPORTANT: Update with your production domain
CORS_ORIGINS=https://sca.campus,https://www.sca.campus

# DATABASE
# For production, consider PostgreSQL or MySQL
DATABASE_URL=sqlite:///outputs/sca_events.db

# BLOCKCHAIN CONFIGURATION
# Use mainnet RPC for production
BLOCKCHAIN_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BLOCKCHAIN_PRIVATE_KEY=your_production_private_key_here
CONTRACT_ADDRESS=your_deployed_contract_address_here

# Campus Department ID
TARGET_DEPT=CS_DEPARTMENT

# DATA MODE
# Set to 'production' for real data (no mock data in production)
DATA_MODE=production

# SECURITY
# Enable HTTPS only
FORCE_HTTPS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=WARNING
